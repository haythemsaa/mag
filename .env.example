# Application
APP_NAME="FleetManager Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fleetmanager
DB_USERNAME=postgres
DB_PASSWORD=

# Redis (Required for cache, queues, sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Cache
CACHE_STORE=redis
CACHE_PREFIX=fleetmanager_cache

# Queue (Redis required for background jobs)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@fleetmanager.fr"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Optional - for S3 file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000
SANCTUM_EXPIRATION=null

# Scribe API Documentation
SCRIBE_AUTH_KEY=

# ============================================
# FLEETMANAGER PRO SPECIFIC CONFIGURATION
# ============================================

# Multi-tenant
DEFAULT_ORGANIZATION_ID=1
SUPER_ADMIN_EMAIL=admin@fleetmanager.fr

# Notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATION_CHANNELS=mail,database
MAINTENANCE_REMINDER_DAYS=7
CONTRACT_EXPIRY_DAYS=30
LICENSE_EXPIRY_DAYS=60

# Alert Schedule (daily alerts sent at this time)
ALERTS_SCHEDULE_TIME="08:00"
ALERTS_TIMEZONE=Europe/Paris

# Fuel Anomaly Detection Thresholds
FUEL_ANOMALY_CONSUMPTION_VARIANCE=0.30
FUEL_ANOMALY_PRICE_VARIANCE=0.25
FUEL_ANOMALY_MIN_QUANTITY=5

# Vehicle Settings
VEHICLE_MILEAGE_WARNING_THRESHOLD=250000
VEHICLE_MILEAGE_CRITICAL_THRESHOLD=300000
DEFAULT_MAINTENANCE_INTERVAL_KM=15000
DEFAULT_MAINTENANCE_INTERVAL_DAYS=180

# Financial Settings
DEFAULT_VAT_RATE=0.20
DEFAULT_CURRENCY=EUR

# Pagination
DEFAULT_PAGINATION_PER_PAGE=15
MAX_PAGINATION_PER_PAGE=100

# GPS Tracking
GPS_TRACKING_ENABLED=true
GPS_UPDATE_INTERVAL_MINUTES=5
GPS_HISTORY_RETENTION_DAYS=90

# Performance
QUERY_LOG_ENABLED=false
SLOW_QUERY_THRESHOLD_MS=1000

# Security & Authentication
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
MAX_LOGIN_ATTEMPTS=5
LOGIN_THROTTLE_MINUTES=15
API_RATE_LIMIT=60
API_RATE_LIMIT_AUTHENTICATED=120

# File Uploads
MAX_UPLOAD_SIZE=10240
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# Reports
REPORT_EXPORT_FORMATS=pdf,excel,csv
REPORT_RETENTION_DAYS=30

# Feature Flags
FEATURE_DRIVER_MOBILE_APP=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_AI_PREDICTIONS=false
FEATURE_EXPORT_REPORTS=true
FEATURE_BULK_IMPORT=true

# Subscription Plans
SUBSCRIPTION_STARTER_VEHICLE_LIMIT=10
SUBSCRIPTION_PROFESSIONAL_VEHICLE_LIMIT=50
SUBSCRIPTION_ENTERPRISE_VEHICLE_LIMIT=null

# ============================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================

# SMS Provider (Twilio, Nexmo, etc.)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Maps Provider
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
MATOMO_SITE_ID=
MATOMO_URL=

# Error Tracking (Sentry - Production)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=local

# ============================================
# DEVELOPMENT/DEBUGGING TOOLS
# ============================================

# Laravel Telescope (Development/Staging only)
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

# Laravel Debugbar (Development only)
DEBUGBAR_ENABLED=false

# Laravel Horizon (Queue Dashboard)
HORIZON_ENABLED=false
HORIZON_PATH=horizon

# Clockwork (Development)
CLOCKWORK_ENABLE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept

# Testing
TESTING_DB_CONNECTION=pgsql
TESTING_DB_DATABASE=fleetmanager_test

# Support & Legal
SUPPORT_EMAIL=support@fleetmanager.fr
SUPPORT_PHONE="+33 1 23 45 67 89"
SUPPORT_URL=https://support.fleetmanager.fr
PRIVACY_POLICY_URL=https://fleetmanager.fr/privacy
TERMS_OF_SERVICE_URL=https://fleetmanager.fr/terms
